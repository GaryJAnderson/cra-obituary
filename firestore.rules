rules_version = '2';

// CRA Obituary — Memories guestbook.
// Paste this into: Firebase console -> Firestore Database -> Rules -> Publish.
//
// - Anyone (anonymous) may read all messages and post a new one.
// - A message can only be edited or "removed" by the same anonymous
//   user that created it (auth.uid == authorUid).
// - "Remove" is an update that sets hidden = true. Hard delete is
//   never allowed, and every edit must append exactly one entry to
//   the revisions array, so nothing is ever lost.

service cloud.firestore {
  match /databases/{database}/documents {

    match /messages/{id} {

      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.relationship is string
        && request.resource.data.relationship.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.hidden == false
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && request.resource.data.revisions is list
        && request.resource.data.revisions.size() == 0
        && (request.resource.data.image == null
            || (request.resource.data.image is string
                && request.resource.data.image.size() <= 900000));

      allow update: if request.auth != null
        && request.auth.uid == resource.data.authorUid
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.relationship is string
        && request.resource.data.relationship.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.hidden is bool
        && request.resource.data.revisions.size() == resource.data.revisions.size() + 1
        && (request.resource.data.image == null
            || (request.resource.data.image is string
                && request.resource.data.image.size() <= 900000));

      allow delete: if false;
    }
  }
}
